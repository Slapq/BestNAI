# BestNAI 环境变量配置

# ── NovelAI API Keys（可选）──────────────────────────────────────────────────
# 逗号或换行分隔。留空也可以：之后通过 /admin/keys 动态添加，并持久化到 SQLite。
BESTNAI_API_KEYS=

# ── 客户端 / 管理认证（留空则该类鉴权放行，仅建议本地开发）──────────────────
BESTNAI_CLIENT_SECRETS=your_client_secret
BESTNAI_ADMIN_SECRETS=your_admin_secret

# ── 是否强制要求认证（false = 内网免鉴权模式）──────────────────────────────
BESTNAI_REQUIRE_AUTH=true

# ── 服务监听 ─────────────────────────────────────────────────────────────────
BESTNAI_HOST=127.0.0.1
BESTNAI_PORT=8010

# ── 动态号池与持久化 ─────────────────────────────────────────────────────────
# 启用后号池由 SQLite 驱动，/admin/keys 的增删改会持久化。
BESTNAI_DYNAMIC_POOL=true
# 留空则使用 <项目根>/data/bestnai.db
# BESTNAI_DB_PATH=S:\VSCODE\BestNAI\data\bestnai.db
# 号池与数据库的重新同步间隔（秒，最小 5）
BESTNAI_KEY_SYNC_INTERVAL_SECONDS=30
# 刷新单个 Key 账号信息的上游超时（秒）
BESTNAI_ACCOUNT_CHECK_TIMEOUT=30

# ── 调度器 ───────────────────────────────────────────────────────────────────
# 所有 Key 都被占用时的排队等待上限（秒）。超时返回 HTTP 503
# UPSTREAM_UNAVAILABLE。每个 Key 同时只处理一个请求，等待严格 FIFO。
BESTNAI_QUEUE_TIMEOUT=30

# ── 上游地址（一般无需修改）──────────────────────────────────────────────────
BESTNAI_NOVELAI_IMAGE_BASE=https://image.novelai.net
BESTNAI_NOVELAI_API_BASE=https://api.novelai.net

# ── 请求与图片限制 ───────────────────────────────────────────────────────────
BESTNAI_MAX_REQUEST_BYTES=268435456
BESTNAI_MAX_UPLOAD_BYTES=20971520
BESTNAI_MAX_IMAGE_STORE_ENTRIES=500

# ── 计费默认值（首次启动写入站点选项，之后以 /admin/options 为准）────────────
# 默认 Anlas 上限（-1 = 不限制），用于旧版 -anlas-N / -points-N 别名
BESTNAI_DEFAULT_MAX_ANLAS=-1
# 免费生图限速
BESTNAI_FREE_RATE_LIMIT_ENABLED=true
BESTNAI_FREE_RATE_LIMIT_COUNT=5
BESTNAI_FREE_RATE_LIMIT_MINUTES=60

# ── 响应语言（zh / en）───────────────────────────────────────────────────────
BESTNAI_LANGUAGE=zh

# ── CORS（留空 = * ，公网部署请显式限制）────────────────────────────────────
# BESTNAI_CORS_ORIGINS=https://nai.example.com

# ── SDK 路径（留空则自动探测 vendor/novelai-sdk/src）────────────────────────
# BESTNAI_SDK_SRC=S:\VSCODE\BestNAI\vendor\novelai-sdk\src
